# bukz configuration
# Copy this file to .env and fill in your keys. NEVER commit .env.
# .env is gitignored, and Claude is permission-blocked + instructed never to read it.
# Edit .env in your own editor — do not paste tokens into an AI chat.

# Default provider when --provider is not passed: ynab | xero
BUKZ_PROVIDER=ynab

# ── YNAB ────────────────────────────────────────────────────────────────
# app.ynab.com → Account Settings → Developer Settings → New Personal Access Token
YNAB_ACCESS_TOKEN=
# Optional: pin a specific budget (find ids with: node bin/bukz.mjs budgets).
# Defaults to your last-used budget.
YNAB_BUDGET_ID=

# ── Xero (Custom Connection, machine-to-machine) ───────────────────────
# developer.xero.com → My Apps → New app → Custom Connection
# Scopes: accounting.transactions.read accounting.settings.read accounting.contacts.read
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional: auto-discovered from your connection if omitted
XERO_TENANT_ID=

# ── Google Sheets hub (optional env fallback) ──────────────────────────
# Prefer CLI flags so skills never need to edit .env:
#   node bin/bukz.mjs sync-config --service-account ./sa.json --spreadsheet-id <id>
# Demo/offline (no keys): node bin/bukz.mjs sync-config --from fixtures/sheets-hub.json
# Column layouts + setup: docs/sheets-config.md
#
# Env below is OPTIONAL — sync-config / sheets code never reads or rewrites .env
# as a file; these are only process-env fallbacks if you set them yourself.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional tab names (defaults: Bills, Rules)
# GOOGLE_SHEETS_BILLS_TAB=Bills
# GOOGLE_SHEETS_RULES_TAB=Rules

# ── Famdash feed (optional) ─────────────────────────────────────────────
# Long random secret. famdash calls GET /api/feed/recent with
# Authorization: Bearer <this value>. Never commit a real value, and never
# paste it into chat. `node bin/bukz.mjs check` prints only whether it is set.
BUKZ_API_KEY=
# Optional bind for `feed-serve` (defaults: 127.0.0.1 and 7801).
# This repo is public — Cipher must CLEAR before any non-loopback URL.
# BUKZ_FEED_HOST=127.0.0.1
# BUKZ_FEED_PORT=7801
