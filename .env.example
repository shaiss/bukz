# bukz configuration
# Copy this file to .env and fill in your keys. NEVER commit .env.
# .env is gitignored, and Claude is permission-blocked + instructed never to read it.
# Edit .env in your own editor — do not paste tokens into an AI chat.

# Default provider when --provider is not passed: ynab | xero
BUKZ_PROVIDER=ynab

# ── YNAB ────────────────────────────────────────────────────────────────
# app.ynab.com → Account Settings → Developer Settings → New Personal Access Token
YNAB_ACCESS_TOKEN=
# Optional: pin a specific budget (find ids with: node bin/bukz.mjs budgets).
# Defaults to your last-used budget.
YNAB_BUDGET_ID=

# ── Xero (Custom Connection, machine-to-machine) ───────────────────────
# developer.xero.com → My Apps → New app → Custom Connection
# Scopes: accounting.transactions.read accounting.settings.read accounting.contacts.read
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Optional: auto-discovered from your connection if omitted
XERO_TENANT_ID=
