# Secrets — API tokens live here and must never be committed
.env
.env.local

# The user's financial data stays on their machine
data/*
!data/.gitkeep
receipts/inbox/*
!receipts/inbox/.gitkeep
receipts/processed/*
!receipts/processed/.gitkeep
receipts/ledger.csv
reports/

# Curated bookkeeping context (bills registry, account→entity map) is private;
# only the committed *.example.json templates and .gitkeep are shared
config/*
!config/.gitkeep
!config/*.example.json

node_modules/
*.log

# Machine-local agent permissions (settings.json is shared; *.local is not)
.claude/settings.local.json

# Local agent session/plan artifacts
.zcode/
.playwright-mcp/
